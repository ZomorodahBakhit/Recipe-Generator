<!DOCTYPE html>
<html lang="en">
<!-- Declares the document type as HTML and sets the language to English -->

<head>
    <!-- Metadata section of the document -->
    <meta charset="UTF-8">
    <!-- Sets the character encoding to UTF-8 -->
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <!-- Ensures compatibility with Internet Explorer -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- Sets the viewport to make the website responsive -->
    <title>YUMnTUM About Us Page</title>
    <!-- Specifies the title of the webpage -->
    <link rel="stylesheet" href="/css/style_aboutus.css">
    <!-- Links an external CSS file -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/boxicons@latest/css/boxicons.min.css">
    <!-- Links the Box Icons library for icons -->
    <link rel="stylesheet" href="https://unpkg.com/swiper/swiper-bundle.min.css" />
    <!-- Links Swiper's CSS for the slider -->
</head>

<body>
    <!-- Main content of the page -->
    <header>
        <!-- Header section -->
        <a href="#" class="logo"><i class='bx bxs-bowl-rice'></i>YUMnTUM</a>
        <!-- Logo linking to the top of the page -->
        <div class="bx bx-menu" id="menu-icon"></div>
        <!-- Menu icon for toggling navigation on smaller screens -->
        <ul class="navbar">
            <!-- Navigation bar links -->
            <li><a href="/">Home</a></li>
            <!-- Link to Home section -->
            <li><a href="#ingredients">Ingredients</a></li>
            <!-- Link to Ingredients section -->
            <li><a href="/Recipes">Recipes</a></li>
            <!-- Link to Recipes section -->
            <li><a href="/AboutUs" class="home-active">About Us</a></li>
            <!-- Link to About Us section with active class -->
            <li><a href="#users">Users</a></li>
            <!-- Link to Users section -->
        </ul>
        <div class="profile">
            <!-- Profile section with image and name -->
            <img src="/img/Users/profile.jpg" alt="">
            <!-- Profile picture -->
            <span>Lila Al Fayed</span>
            <!-- Profile name -->
            <i class='bx bx-caret-down'></i>
            <!-- Dropdown icon -->
        </div>
    </header>

    <section class="home swiper" id="home">
        <!-- Home section with a swiper slider -->
        <div class="swiper-wrapper">
            <!-- Swiper wrapper for multiple slides -->
            <div class="swiper-slide container">
                <!-- Individual slide container -->
                <div class="home-text">
                    <!-- Text content within the home section -->
                    <span>Discover the Heart and Soul Behind Every Dish.</span>
                    <!-- Subheading text -->
                    <h1>All You Need<br> to Know About US </h1>
                    <!-- Main heading text -->

                    
                </div>
                <img src="/img/Aboutus/aboutsushome.png" alt="">
                <!-- Slide image -->
            </div>
        </div>
    </section>

    <section class="about" id="about">
        <!-- About Us section -->
        <img src="/img/Aboutus/bilgiunicampus1.png" alt="">
        <!-- Image for the About Us section -->
        <div class="about-text">
            <!-- Text content within the About Us section -->
            <span>About Us</span>
            <!-- Section heading -->
            <p>At YUMnTUM, we believe that food is more than just nourishment...</p>
            <!-- Paragraph text -->
            <span>Who Are We?</span>
            <!-- Subheading -->
            <p>We are a passionate team of food enthusiasts...</p>
            <!-- Additional paragraph text -->
        </div>
    </section>

    <section class="about" id="about">
        <!-- Second part of the About Us section -->
        <div class="about-text">
            <span>What We Offer</span>
            <p>Personalized Recommendations...</p>
            <p>Creative Inspiration...</p>
            <span>Why Choose Us?</span>
            <p>Easy-to-Follow Recipes...</p>
            <p>Time Saving Features...</p>
        </div>
        <img src="/img/Aboutus/chef3.png" alt="">
        <!-- Image for the second part of the About Us section -->
    </section>

    <section class="about" id="about">
        <!-- Third part of the About Us section -->
        <img src="/img/Aboutus/cookbook.png" alt="">
        <!-- Image for the third part of the About Us section -->
        <div class="about-text">
            <span>Our Vision</span>
            <p>To be your go-to platform...</p>
            <span>Join Our Journey</span>
            <p>At YUMnTUM, we’re not just sharing recipes...</p>
        </div>
    </section>

    <section class="footer" id="footer">
        <!-- Footer section -->
        <div class="footer-box">
            <!-- First footer column -->
            <a href="#" class="logo"><i class='bx bxs-bowl-rice'></i>YUMnTUM</a>
            <p>Bilgi University, Emniyettepe...</p>
            <div class="social">
                <!-- Social media links -->
                <a href="#"><i class='bx bxl-facebook'></i></a>
                <a href="#"><i class='bx bxl-twitter'></i></a>
                <a href="#"><i class='bx bxl-instagram'></i></a>
                <a href="#"><i class='bx bxl-youtube'></i></a>
            </div>
        </div>
        <div class="footer-box">
            <h2>Catalogue</h2>
            <a href="/">Home</a>
            <a href="#">Ingredients</a>
            <a href="/Recipes">Recipes</a>
            <a href="/AboutUs">About Us</a>
        </div>
        <div class="footer-box">
            <!-- Third footer column -->
            <h2>Useful Links</h2>
            <a href="#">Payment & Tax</a>
            <a href="#">Terms Of Use</a>
            <a href="#">Our Blog</a>
            <a href="#">Policy</a>
        </div>
        <div class="footer-box">
            <!-- Fourth footer column -->
            <h2>Newsletter</h2>
            <p>Subscribe to our <br>Email Newsletter</p>
            <form action="">
                <!-- Subscription form -->
                <i class='bx bxs-envelope'></i>
                <input type="email" name="" id="" placeholder="Enter Your Email">
                <i class='bx bx-arrow-back bx-rotate-180'></i>
            </form>
        </div>
    </section>

    <div class="copyright">
        <!-- Copyright notice -->
        <p>&#169; YUMnTUM All Rights Reserved.</p>
    </div>

    <script src="https://unpkg.com/swiper/swiper-bundle.min.js"></script>
    <!-- Links Swiper JS library -->
    <script src="/js/main.js"></script>
    <!-- Links external JavaScript file -->
</body>

</html>
